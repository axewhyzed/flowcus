{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Environment": "Production",
  "ConnectionStrings": {
    "DBLocal": "User ID=postgres;Password=YOUR_PRODUCTION_DB_PASSWORD;Host=your-production-host.com;Port=5432;Database=flowcus_prod;"
  },
  "Jwt": {
    "Key": "YOUR_STRONG_256BIT_JWT_KEY_MIN_32_CHARS_CHANGE_THIS_IN_PRODUCTION",
    "Issuer": "FlowcusAPI",
    "Audience": "FlowcusClient"
  },
  "AuthSettings": {
    "MaxFailedAttempts": 3,
    "LockoutMinutes": 15,
    "IpRateLimitPerMinute": 30,
    "UserRateLimitPerMinute": 10,
    "BcryptWorkFactor": 12
  },
  "ENCRYPTION_KEY": "YOUR_PRODUCTION_ENCRYPTION_KEY_MIN_16_CHARS"
}

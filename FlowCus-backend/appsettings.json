{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "DBLocal": ""
  },
  "Jwt": {
    "Key": "REPLACE_WITH_STRONG_256BIT_KEY_IN_DEPLOYMENT_environment_variable",
    "Issuer": "FlowcusAPI",
    "Audience": "FlowcusClient"
  },
  "AuthSettings": {
    "MaxFailedAttempts": 3,
    "FirstLockoutMinutes": 5,
    "SecondLockoutMinutes": 15,
    "MaxLockoutMinutes": 60,
    "IpRateLimitPerMinute": 30,
    "UserRateLimitPerMinute": 10,
    "BcryptWorkFactor": 12
  }
}

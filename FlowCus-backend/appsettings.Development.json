{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Environment": "Development",
  "ConnectionStrings": {
    "DBLocal": "User ID=postgres;Password=YOUR_LOCAL_DB_PASSWORD;Host=localhost;Port=5432;Database=flowcus_dev;"
  },
  "Jwt": {
    "Key": "dev-jwt-key-for-testing-min-32-characters-long-replace-in-prod",
    "Issuer": "FlowcusAPI",
    "Audience": "FlowcusClient"
  },
  "AuthSettings": {
    "MaxFailedAttempts": 3,
    "LockoutMinutes": 2,
    "IpRateLimitPerMinute": 30,
    "UserRateLimitPerMinute": 10,
    "BcryptWorkFactor": 12
  },
  "ENCRYPTION_KEY": "dev-encryption-key-16-chars-min-replace-in-prod"
}

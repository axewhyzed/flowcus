{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Environment": "Development",
  "ConnectionStrings": {
    "DBLocal": "User ID=postgres;Password=YOUR_LOCAL_DB_PASSWORD;Host=localhost;Port=5432;Database=flowcus_dev;"
  },
  "Jwt": {
    "Key": "your-256-bit-key-at-least-32-characters-long-for-development",
    "Issuer": "FlowcusAPI",
    "Audience": "FlowcusClient"
  },
  "AuthSettings": {
    "MaxFailedAttempts": 3,
    "LockoutMinutes": 2,
    "IpRateLimitPerMinute": 30,
    "UserRateLimitPerMinute": 10,
    "BcryptWorkFactor": 12
  }
}
